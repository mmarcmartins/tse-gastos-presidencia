-
  const SENADO = (ano) => `https://adm.senado.gov.br/adm-dadosabertos/api/v1/senadores/despesas_ceaps/${ano}`
  const PORTAL = (ano) => `https://portaldatransparencia.gov.br/cartoes/consulta?ordenarPor=valorTotal&direcao=desc&de=01/01/${ano}&ate=31/12/${ano}&orgaos=OS20000`
  const PORTAL_DOWNLOAD = "https://portaldatransparencia.gov.br/download-de-dados/cpgf"
  const recente = anos[0]
  const ou = (v, f) => (v === undefined ? "–" : f(v))

mixin tabela(titulo, coluna, linhas)
  div
    h3= titulo
    .tbl
      table
        thead
          tr
            th
            th= coluna
            th.n Valor (R$)
        tbody
          each l, i in linhas
            tr
              td.i= i + 1
              td #{l.descricao}
                if l.sigiloso
                  |  #[span.pill sigiloso]
                span.sub= l.detalhe
              td.n= brl(l.valor)

mixin meses(titulo, meses)
  - const max = Math.max(...meses.map((m) => m.valor))
  - const maior = meses.find((m) => m.valor === max)
  div
    h3= titulo
    .months(role="img" aria-label=`Gastos por mês: o maior é ${maior.mes}, com R$ ${brl(maior.valor)}` style=`--n:${meses.length}`)
      each m in meses
        .mo
          .b(class=(m === maior ? "max" : undefined) style=`height:${max ? Math.round(m.valor / max * 100) : 0}%` title=`R$ ${brl(m.valor)}`)
          .lbl= m.mes

doctype html
html(lang="pt-BR")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover")
    title Gastos dos Candidatos 2026
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,500;6..72,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap")
    style
      include styles.css
    style
      each a in anos
        | #t-#{a.ano}:checked ~ .paineis #p-#{a.ano} { display: block; }
        | #t-#{a.ano}:checked ~ .tabs label[for="t-#{a.ano}"] { background: var(--surface); color: var(--fg); border-color: var(--line); border-bottom-color: var(--surface); }
        | #t-#{a.ano}:focus-visible ~ .tabs label[for="t-#{a.ano}"] { outline: 2px solid var(--accent); outline-offset: 2px; }
  body
    .wrap
      header
        .eyebrow Eleição presidencial · 2º turno em 25/10/2026
        h1 Maiores gastos públicos de Lula e Flávio Bolsonaro
        p.lede Os 10 maiores gastos de cada ano, de 2023 a 2026, que aparecem nos portais oficiais de transparência, para cada candidato. São dados de dinheiro público ligado ao cargo de cada um, não das contas pessoais, que estão em disputa no TSE.
        .status
          span Atualizado em #[strong#upd #{atualizado_em}]
          span #[a(href=SENADO(ultimoSenado.ano) target="_blank" rel="noopener") Senado]: dados até #[strong #{ultimoSenado.flavio.ate}]
          span #[a(href=PORTAL(ultimoPortal.ano) target="_blank" rel="noopener") Portal da Transparência]: dados até #[strong #{ultimoPortal.lula.ate}]

      .notice #[b As duas colunas não são comparáveis.] A do Flávio é a cota de gabinete de um senador, gasta por ele e por outras pessoas do gabinete. A do Lula é o cartão corporativo da Presidência da República inteira, usado por servidores. Os gastos ligados diretamente ao presidente são classificados como sigilosos e aparecem só como um valor total.

      section.resumo(aria-labelledby="h-resumo")
        h3#h-resumo Resumo dos últimos 4 anos (R$)
        .tbl
          table
            thead
              tr
                th Ano
                th.n Lula: gastos sigilosos da Presidência
                th.n Lula: cartão da Presidência, total
                th.n Flávio: cota parlamentar, total
            tbody
              each a in anos
                tr
                  td= a.ano
                  td.n= ou(a.lula && a.lula.sigiloso_presidencia, brl)
                  td.n= ou(a.lula && a.lula.total, brl)
                  td.n= ou(a.flavio && a.flavio.total, brl)
        p.note Dados mais recentes: Portal até #{ultimoPortal.lula.ate}, Senado até #{ultimoSenado.flavio.ate}. “–” indica fonte indisponível na última atualização.

      .anos
        each a, i in anos
          input(type="radio" name="ano" id=`t-${a.ano}` checked=(i === 0))
        .tabs(aria-label="Escolha o ano")
          each a in anos
            label(for=`t-${a.ano}`)= a.ano
        .paineis
          each a in anos
            .painel(id=`p-${a.ano}`)
              .cols
                section.cand(aria-labelledby=`h-lula-${a.ano}`)
                  div
                    h2(id=`h-lula-${a.ano}`) Lula
                    .role Presidente da República · candidato à reeleição (PT)
                    if a.lula
                      .src Fonte: #[a(href=PORTAL(a.ano) target="_blank" rel="noopener") Portal da Transparência], cartões de pagamento da Presidência (jan–#{a.lula.ate})
                    else
                      .src Fonte: #[a(href=PORTAL(a.ano) target="_blank" rel="noopener") Portal da Transparência]
                  if !a.lula
                    p.note O Portal da Transparência não respondeu na última atualização. A rotina tenta de novo no próximo dia.
                  else
                    .kpis
                      .kpi
                        .v= compacto(a.lula.sigiloso_presidencia)
                        .l gastos sigilosos da Presidência
                      .kpi
                        .v= compacto(a.lula.sigiloso_vice)
                        .l gastos sigilosos da Vice-Presidência
                    +tabela("10 maiores gastos por portador e favorecido", "Unidade / favorecido", a.lula.top)
                    +meses("Por mês do extrato (R$)", a.lula.meses)
                    p.note Linhas sem a marca “sigiloso” são gastos de servidores com cartão corporativo. A EBC e a Imprensa Nacional são órgãos vinculados à Presidência. Nomes de portadores não são exibidos.

                section.cand(aria-labelledby=`h-flavio-${a.ano}`)
                  div
                    h2(id=`h-flavio-${a.ano}`) Flávio Bolsonaro
                    .role Senador (RJ) · candidato à Presidência (PL)
                    if a.flavio
                      .src Fonte: #[a(href=SENADO(a.ano) target="_blank" rel="noopener") Senado Federal], cota parlamentar CEAPS (jan–#{a.flavio.ate})
                    else
                      .src Fonte: #[a(href=SENADO(a.ano) target="_blank" rel="noopener") Senado Federal]
                  if !a.flavio
                    p.note O Senado não respondeu na última atualização. A rotina tenta de novo no próximo dia.
                  else
                    .kpis
                      .kpi
                        .v R$ #{brl(a.flavio.total)}
                        .l total reembolsado em #{a.ano}
                      .kpi
                        .v= a.flavio.despesas
                        .l despesas lançadas
                    +tabela("10 maiores reembolsos", "Data / despesa", a.flavio.top)
                    - const maxCat = Math.max(...a.flavio.categorias.map((x) => x.valor))
                    div
                      h3 Por categoria
                      .cat
                        each x in a.flavio.categorias
                          .cat-row
                            span= x.nome
                            span.n= brl(x.valor)
                            .track
                              .fill(style=`width:${+Math.max(0.5, x.valor / maxCat * 100).toFixed(1)}%`)
                    +meses("Por mês de lançamento (R$)", a.flavio.meses)
                    p.note Valores pela data de lançamento no Senado. O mês corrente ainda pode receber lançamentos. Nos passageiros, só aparece se era o próprio senador.

      footer
        span Fontes oficiais (dados baixados automaticamente todos os dias):
        span #[a(href=PORTAL(recente.ano) target="_blank" rel="noopener") Portal da Transparência: cartões de pagamento da Presidência da República]
        span #[a(href=PORTAL_DOWNLOAD target="_blank" rel="noopener") Portal da Transparência: arquivos mensais do cartão de pagamento (CPGF)]
        each a in anos
          span #[a(href=SENADO(a.ano) target="_blank" rel="noopener") Senado Federal: dados abertos da cota parlamentar (CEAPS) #{a.ano}]
        span #[a(href="gastos.json") Dados usados nesta página (JSON)]
        span Nomes de servidores, assessores e passageiros foram omitidos. Esta página não inclui dados bancários, fiscais ou telefônicos pessoais de nenhum candidato.
